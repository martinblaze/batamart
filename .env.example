# Database (REQUIRED)
DATABASE_URL="postgresql://username:password@localhost:5432/tradezy_db"
POOLED_DATABASE_URL="postgresql://username:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://username:password@db.project-ref.supabase.co:5432/postgres"

# Cron (REQUIRED on Vercel for scheduled maintenance routes)
CRON_SECRET="change-me-to-a-long-random-cron-secret"

# JWT Secret (REQUIRED)
JWT_SECRET="change-me-to-a-long-random-string"

# Twilio (Optional - OTP will log to console if not set)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Email (Optional)
# Email routing:
#   verification codes (sign-up, login, PIN reset) -> Resend only
#   everything else (order emails, receipts, reminders, broadcasts) -> your SMTP
#   server (the VPS), then Brevo if BREVO_API_KEY is set
RESEND_API_KEY=""
RESEND_FROM_EMAIL="BataMart <support@batamart.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Sender for everything except codes, e.g. "BataMart <hello@batamart.com>"
EMAIL_FROM=""
# Optional backup for the non-code emails
BREVO_API_KEY=""

EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER=""
EMAIL_PASS=""

# Stripe (Optional)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=""

# Flutterwave v3 (REQUIRED — active payment + withdrawal provider)
# Get these from Flutterwave dashboard: Settings -> API Keys -> Developers tab.
# That page issues THREE keys as a set (Public, Secret, Encryption) — this app
# only needs the first two. The Encryption Key is for v3's older *direct*
# card-charge endpoint (client encrypts card data, POSTs straight to /charges,
# no redirect) — unused by the hosted-checkout /payments redirect flow this
# app uses, so it's fine to leave unset.
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X"
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY="FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X"
FLUTTERWAVE_BASE_URL="https://api.flutterwave.com/v3"
# Not used by any current route — kept only in case you build v3's direct
# charge or webhook-signature verification later.
FLUTTERWAVE_ENCRYPTION_KEY=""

# Credo (Legacy / no longer used by the app, kept only for rollback)
CREDO_SECRET_KEY="sk_test_your_key_here"
NEXT_PUBLIC_CREDO_PUBLISHABLE_KEY="pk_test_your_key_here"
CREDO_PUBLIC_KEY="pk_test_your_key_here"

# Paystack (Legacy / no longer used by the app, kept only for rollback)
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Sign-In (Optional)
# Use your Web OAuth Client ID from Google Cloud.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_ID=""

# Moderation
GEMINI_API_KEY=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
