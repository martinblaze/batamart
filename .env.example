# Database (REQUIRED)
DATABASE_URL="postgresql://username:password@localhost:5432/tradezy_db"
POOLED_DATABASE_URL="postgresql://username:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://username:password@db.project-ref.supabase.co:5432/postgres"

# Cron (REQUIRED on Vercel for scheduled maintenance routes)
CRON_SECRET="change-me-to-a-long-random-cron-secret"

# JWT Secret (REQUIRED)
JWT_SECRET="change-me-to-a-long-random-string"

# Twilio (Optional - OTP will log to console if not set)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Email (Optional)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER=""
EMAIL_PASS=""

# Stripe (Optional)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=""

# Flutterwave v4 (REQUIRED — active payment + withdrawal provider)
# Get these from your Flutterwave v4 developer sandbox onboarding — Client ID,
# Client Secret, and Encryption Key are issued together, NOT the same as the
# older FLWSECK_TEST-.../FLWPUBK_TEST-... "Secret Key"/"Public Key" pair.
FLUTTERWAVE_CLIENT_ID=""
FLUTTERWAVE_CLIENT_SECRET=""
# Same value, exposed to the browser — card fields are AES-256-GCM encrypted
# client-side with this key before anything is sent to our server (see
# lib/finance/flutterwave-encrypt.ts). This is the intended design (the
# matching decryption half is held by Flutterwave), not a leaked secret.
NEXT_PUBLIC_FLUTTERWAVE_ENCRYPTION_KEY=""
# Sandbox API host — override to the production host once Flutterwave
# confirms it for your live account (not publicly documented as of writing).
FLUTTERWAVE_API_BASE_URL="https://developersandbox-api.flutterwave.com"

# Credo (Legacy / no longer used by the app, kept only for rollback)
CREDO_SECRET_KEY="sk_test_your_key_here"
NEXT_PUBLIC_CREDO_PUBLISHABLE_KEY="pk_test_your_key_here"
CREDO_PUBLIC_KEY="pk_test_your_key_here"

# Paystack (Legacy / no longer used by the app, kept only for rollback)
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Sign-In (Optional)
# Use your Web OAuth Client ID from Google Cloud.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_ID=""

# Moderation
GEMINI_API_KEY=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
