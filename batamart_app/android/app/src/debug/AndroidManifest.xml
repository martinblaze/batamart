<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Debug-only: Android blocks cleartext (plain HTTP) traffic by
         default from API 28+. Env.apiBaseUrl's dev default
         (http://10.0.2.2:3000, for a local `next dev`) is cleartext, so
         debug builds need this to reach it. Not present in release —
         production must be HTTPS. -->
    <application android:usesCleartextTraffic="true"/>
</manifest>
